{
  "name": "@bibbly/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Bibbly for iOS and Android: live captions in your language, meeting notes, tasks and the Bibbly Stick.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform android --platform ios --output-dir dist",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "preview:web": "expo export --platform web --output-dir dist-web",
    "e2e": "EXPO_PUBLIC_BIBBLY_PROVIDER_BASE_URL=http://127.0.0.1:47123 npm run preview:web && node e2e/preview.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@bibbly/connectors": "file:../../packages/connectors",
    "@bibbly/core": "file:../../packages/core",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.24",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "3.5.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "6.0.3"
  }
}
