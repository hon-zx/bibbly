{
  "name": "@bibbly/server",
  "version": "0.1.0",
  "private": true,
  "description": "Bibbly server: live captions shared by link or QR code (translated once per listener language), and the sign-in broker for connected apps.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bibbly-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@bibbly/core": "0.1.0",
    "ws": "8.22.0",
    "@bibbly/connectors": "0.1.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
