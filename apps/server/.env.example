# Copy to apps/server/.env (git-ignored) and fill in what you use. Never commit the real file.
PORT=8787
# Translation for room listeners (optional).
ANTHROPIC_API_KEY=

# Connected apps: the public address of this server. Register <BIBBLY_PUBLIC_URL>/oauth/<provider>/callback
# as the redirect URI with each provider (google, microsoft, slack, notion, lark). See docs/connectors.md.
BIBBLY_PUBLIC_URL=http://localhost:8787
BIBBLY_GOOGLE_CLIENT_ID=
BIBBLY_GOOGLE_CLIENT_SECRET=
BIBBLY_MICROSOFT_CLIENT_ID=
BIBBLY_MICROSOFT_CLIENT_SECRET=
BIBBLY_MICROSOFT_TENANT=common
BIBBLY_SLACK_CLIENT_ID=
BIBBLY_SLACK_CLIENT_SECRET=
BIBBLY_NOTION_CLIENT_ID=
BIBBLY_NOTION_CLIENT_SECRET=
BIBBLY_LARK_APP_ID=
BIBBLY_LARK_APP_SECRET=
# lark (global) or feishu (China)
BIBBLY_LARK_REGION=lark
# Set to 1 behind a reverse proxy, so rate limits use X-Forwarded-For.
BIBBLY_TRUST_PROXY=0
