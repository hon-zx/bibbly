{
  "name": "@bibbly/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bibbly for Windows, macOS and Linux: live multilingual captions, meeting notes, tasks and the Bibbly Stick.",
  "author": "Bibbly",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package:linux": "electron-builder --linux AppImage deb",
    "package:mac": "electron-builder --mac dmg",
    "package:win": "electron-builder --win nsis",
    "e2e": "xvfb-run -a node e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0"
  },
  "devDependencies": {
    "@bibbly/connectors": "0.1.0",
    "@bibbly/core": "0.1.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
