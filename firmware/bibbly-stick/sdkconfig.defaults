# Bibbly Stick: ESP32-S3 with 16 MB flash, USB OTG device, Bluetooth LE (NimBLE).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# USB audio needs the 1 ms tick: the isochronous endpoint is serviced every frame.
CONFIG_FREERTOS_HZ=1000
# Logs on the UART pins (the USB port belongs to TinyUSB).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Bluetooth LE peripheral for syncing to the phone.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y

# microSD over SDMMC with FAT. Short 8.3 names are all the recorder uses.
CONFIG_FATFS_LFN_NONE=y
CONFIG_FATFS_IMMEDIATE_FSYNC=n
CONFIG_FATFS_PER_FILE_CACHE=y

# Hardware AES for the recording key (on by default; listed for clarity).
CONFIG_MBEDTLS_HARDWARE_AES=y
