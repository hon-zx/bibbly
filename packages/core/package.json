{
  "name": "@bibbly/core",
  "version": "0.1.0",
  "description": "Shared Bibbly engine: languages, audio, speech providers, Claude translation and clarity, sessions, rooms, exports and the Bibbly Stick protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./claude": { "types": "./dist/llm/claude.d.ts", "default": "./dist/llm/claude.js" },
    "./speech/azure": { "types": "./dist/speech/azure.d.ts", "default": "./dist/speech/azure.js" },
    "./speech/whisper": { "types": "./dist/speech/whisper.d.ts", "default": "./dist/speech/whisper.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "zod": "4.6.7"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "microsoft-cognitiveservices-speech-sdk": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "zod": "4.6.7"
  }
}
